Script block on page to connect to hub (only connect once)
=============================================================================================================================================================

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    // Only once!
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/presenceHub")
        .build();

    connection.start()
        .then(() => console.log("✅ Connected to PresenceHub"))
        .catch(err => console.error("SignalR connect error:", err));

    connection.on("UserPresenceChanged", (user, isOnline) => {
        console.log("Presence changed:", user, isOnline);
    });
</script>
