using System;
using System.IO;

public class LoggingService
{
    private readonly string _logDirectory;
    private readonly string _logFilePath;

    public LoggingService(string logDirectory)
    {
        _logDirectory = logDirectory;
        
        // Create directory if it doesn't exist
        if (!Directory.Exists(_logDirectory))
            Directory.CreateDirectory(_logDirectory);

        // File name: log-2025-12-02.txt
        _logFilePath = Path.Combine(_logDirectory, $"log-{DateTime.UtcNow:yyyy-MM-dd}.txt");
    }

    public void Log(string message)
    {
        var logEntry = $"{DateTime.UtcNow:yyyy-MM-dd HH:mm:ss} | {message}{Environment.NewLine}";
        File.AppendAllText(_logFilePath, logEntry);
    }
}

