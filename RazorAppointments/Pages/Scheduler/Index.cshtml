@page "/Scheduler"
@model RazorAppointments.Pages.Scheduler.IndexModel
@using RazorAppointments.Hubs

@* @functions {
    public string FilterUsername => Model.FilterUsername;
    public string FilterType => Model.FilterType;
} *@


<form method="get">
    <label for="roomSelect">Select Room:</label>
    <select id="roomSelect" name="selectedRoomId" asp-for="SelectedRoomID" asp-items="Model.RoomsList" class="form-control" onchange="this.form.submit()">
        <option value="0">-- Select a Room --</option>
        <option value="-1">Other (enter manually)</option>
    </select>
  
</form>
<div class="form-check form-switch mb-3">
    <input class="form-check-input" type="checkbox" id="onlineOnlyToggle" />
    <label class="form-check-label" for="onlineOnlyToggle">Show Online Only</label>
</div>
@* <div class="form-group mb-3">
    <label for="usernameFilter">Filter by Username:</label>
    <input type="text" id="usernameFilter" class="form-control" placeholder="Enter username..." />
</div> *@

@* <div class="form-group mb-3">
    <label for="typeFilter">Filter by Appointment Type:</label>
    <input type="text" id="typeFilter" class="form-control" placeholder="Enter appointment type..." />
</div> *@

@if (Model.SelectedRoomID == -1)
{
    <div id="customRoomDiv" style="display:block; margin-top: 10px;">
        <label>Enter custom room name:</label>
        <input type="text" name="CustomRoomName" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit</button>
}
@* <div class="form-group mt-3">
    <label for="FilterUsername">Filter by Username:</label>
    <input type="text" id="FilterUsername" name="FilterUsername" class="form-control" value="@Model.FilterUsername" />
</div>

<div class="form-group">
    <label for="FilterType">Filter by Type:</label>
    <input type="text" id="FilterType" name="FilterType" class="form-control" value="@Model.FilterType" />
</div> *@
<h3>Appointments in Selected Room</h3>
@if (Model.SelectedRoomID == 0)
{
<p><em>Please select a room.</em></p>
}
else if (Model.AppointmentsInSelectedRoom.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th> Username <input type="text" id="usernameFilter" class="form-control" placeholder="Enter username..." /></th>
                <th>Type <input type="text" id="typeFilter" class="form-control" placeholder="Enter appointment type..." /></th>
                <th>Status</th>
                <th>Created</th>
                <th>Notified</th>
                <th>Acknowledged</th>
                <th>Actions</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appt in Model.AppointmentsInSelectedRoom)
            {
                <tr>
                    <td>@appt.AppointmentID</td>
                    <td>@appt.Username</td>
                    <td>@appt.AppointmentType</td>
                    <td>@appt.Status</td>
                    <td>@appt.CreatedAt.ToString("g")</td>
                    <td>@(appt.Notified ? "Yes" : "No")</td>
                    <td>@(appt.Acknowledged == true ? "Yes" : appt.Acknowledged == false ? "No" : "")</td>
                    <td>
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@appt.AppointmentID" style="display:inline;">
                            <input type="hidden" name="SelectedRoomID" value="@Model.SelectedRoomID" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    @(appt.Status == "Canceled" || appt.Status == "Complete" ? "disabled" : "")>
                                Cancel
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Complete" asp-route-id="@appt.AppointmentID" style="display:inline;">
                            <input type="hidden" name="SelectedRoomID" value="@Model.SelectedRoomID" />
                            <button type="submit" class="btn btn-primary btn-sm"
                                    @(appt.Status == "Canceled" || appt.Status == "Complete" ? "disabled" : "")>
                                Complete
                            </button>
                        </form>

                    </td>
                    <td>
                        @(PresenceHub.IsUserOnline(appt.Username)
                                        ? "Online"
                                        : "Offline")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (Model.SelectedRoomID > 0)
{
    <p><em>No appointments found for this room.</em></p>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<h2>Scheduler</h2>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <span>Username</span> <input type="text" id="usernameFilter" class="form-control" placeholder="Enter username..." />
                </div>
            </th>
            <th>
                <div style="display: flex; align-items: center; gap: 5px;">
                   <span>Type</span><input type="text" id="typeFilter" class="form-control" placeholder="Enter appointment type..." />
                </div>
            </th>
            <th>Status</th>
            <th>Room</th>
            <th>Created</th>
            @*<th>Started</th>*@
            @*<th>Completed</th>*@
            @*<th>Canceled</th>*@
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="tableBody">
        @foreach (var appt in Model.Appointments)
        {
            var isOnline = PresenceHub.IsUserOnline(appt.Username);
            
            <tr data-online ="@(isOnline ? "true" : "false")">
                <td>@appt.AppointmentID</td>
                <td>@appt.Username</td>
                <td>@appt.AppointmentType</td>
                <td>@appt.Status</td>
                <td>@appt.Room </td>
                <td>@appt.CreatedAt.ToString("g")</td>
                <td>
                    <form method="post" asp-page-handler="Accept" asp-route-id="@appt.AppointmentID">
                        <input type="hidden" name="appointmentId" value="@appt.AppointmentID" />
                        <input type="hidden" name="selectedRoomId" value="@Model.SelectedRoomID" />
                        <button type="submit" class="btn btn-success" @(appt.Status == "In Progress" ? "disabled" : "")> Accept </button>
                    </form>
                </td>
                <td>@(isOnline ? "Online" : "Offline")</td>
                @* <td>
                    @(PresenceHub.IsUserOnline(appt.Username)
                                    ? "Online"
                                    : "Offline")
                </td> *@
            </tr>
        }
    </tbody>
</table>
<script>
        const toggle = document.getElementById("onlineOnlyToggle");
        const usernameInput = document.getElementById("usernameFilter");
        const typeInput = document.getElementById("typeFilter");

    // Restore saved state on page load
    document.addEventListener("DOMContentLoaded", () => {
        const savedToggle = sessionStorage.getItem("onlineOnlyToggle");
        const savedUsername = sessionStorage.getItem("usernameFilter");
        const savedType = sessionStorage.getItem("typeFilter");

        if (savedToggle === "true") {
            toggle.checked = true;
        }

        if (savedUsername) {
            usernameInput.value = savedUsername;
        }

        if (savedType) {
        typeInput.value = savedType;
        }

        applyFilter();
    });

    // Save state and re-apply filter when toggled
    toggle.addEventListener("change", () => {
        sessionStorage.setItem("onlineOnlyToggle", toggle.checked);
        applyFilter();
    });

    // Save state and re-apply filter on input
    usernameInput.addEventListener("input", () => {
        sessionStorage.setItem("usernameFilter", usernameInput.value);
        applyFilter();
    });


    typeInput.addEventListener("input", () => {
        sessionStorage.setItem("typeFilter", typeInput.value);
        applyFilter();
    });

    // Filtering function
    function applyFilter() {
        const showOnlineOnly = toggle.checked;
        const usernameFilter = usernameInput.value.toLowerCase();
        const typeFilter = typeInput.value.toLowerCase();

        document.querySelectorAll("#tableBody tr").forEach(row => {
            const isOnline = row.getAttribute("data-online") === "true";
            const username = row.querySelector("td:nth-child(2)").textContent.toLowerCase();
            const type = row.querySelector("td:nth-child(3)").textContent.toLowerCase();

            const matchesOnline = !showOnlineOnly || isOnline;
            const matchesUsername = !usernameFilter || username.includes(usernameFilter);
            const matchesType = !typeFilter || type.includes(typeFilter);

            row.style.display = matchesOnline && matchesUsername && matchesType ? "" : "none";
        });
    }

    // Refresh appointments but keep filters applied
    setInterval(() => {
        $("#tableBody").load(window.location.href + " #tableBody > *", function () {
            applyFilter();
        });
    }, 5000);

</script>