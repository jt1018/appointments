<input type="text" id="searchBox" placeholder="Search..." />

<script>
    // Restore previous value on page load
    document.addEventListener("DOMContentLoaded", () => {
        const searchBox = document.getElementById("searchBox");
        const saved = localStorage.getItem("searchValue");
        if (saved) searchBox.value = saved;

        // Save on every change
        searchBox.addEventListener("input", () => {
            localStorage.setItem("searchValue", searchBox.value);
        });
    });

    // Optional: clear the saved value if search is submitted
    document.getElementById("searchForm").addEventListener("submit", () => {
        localStorage.removeItem("searchValue");
    });
</script>

