@page
@model RazorAppointments.Pages.User.UserNotificationsModel

<h2>Notifications</h2>
<div id="notification-container"></div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .build();

    connection.on("ReceiveNotification", function(data) {
        const container = document.getElementById("notification-container");
        const div = document.createElement("div");
        div.innerHTML = `
            <p>${data.Message}</p>
            <button onclick="respondToAppointment(${data.AppointmentId}, true)">Yes</button>
            <button onclick="respondToAppointment(${data.AppointmentId}, false)">No</button>
        `;
        container.appendChild(div);
    });

    connection.start();

    function respondToAppointment(appointmentId, isConfirmed) {
        fetch('/User/UserNotifications?handler=Respond', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ AppointmentId: appointmentId, Confirmed: isConfirmed })
        });
    }
</script>
